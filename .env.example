APP_NAME="Ludo Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== DATABASE MySQL =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ludo_tracker
DB_USERNAME=root
DB_PASSWORD=

# ===== SESSION =====
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===== CACHE =====
CACHE_STORE=database
CACHE_DRIVER=file

# ===== FILESYSTEM =====
FILESYSTEM_DISK=local
UPLOADS_DISK=public

# ===== CLOUDINARY =====
# Untuk Railway, isi CLOUDINARY_URL dan set UPLOADS_DISK=cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ludo-tracker

# ===== QUEUE =====
QUEUE_CONNECTION=database

# ===== BROADCAST =====
BROADCAST_CONNECTION=log

# ===== STORAGE =====
# Local upload default memakai public/uploads.
